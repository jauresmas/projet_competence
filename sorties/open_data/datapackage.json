  "resources": [
    {
      "name": "batiments-communaux",
      "title": "Bâtiments communaux",
      "description": "Bâtiments BD TOPO situés à au moins 50 % sur une parcelle de la commune de Chambéry (fichier DGFiP des personnes morales).",
      "path": "batiments_communaux.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "id_bien",
            "title": "Identifiant du bien",
            "type": "string",
            "description": "Clé unique partagée avec la GMAO (AS-TECH) : BAT-<quartier>-<n°>"
          },
          {
            "name": "nom",
            "title": "Nom du bien",
            "type": "string",
            "description": "Toponyme BD TOPO ou libellé à compléter"
          },
          {
            "name": "type_bien",
            "title": "Type de bien",
            "type": "string",
            "description": "Famille fonctionnelle",
            "constraints": {
              "enum": [
                "ADM",
                "ENS",
                "SPO",
                "CUL",
                "REL",
                "SAN",
                "TEC",
                "COM",
                "LOG",
                "ANX",
                "AQU"
              ]
            }
          },
          {
            "name": "type_bien_libelle",
            "title": "Type de bien (libellé)",
            "type": "string"
          },
          {
            "name": "quartier",
            "title": "Quartier",
            "type": "string",
            "description": "Code du quartier de la Ville"
          },
          {
            "name": "adresse",
            "title": "Adresse",
            "type": "string",
            "description": "Adresse BAN rattachée à la parcelle"
          },
          {
            "name": "idu_parcelle",
            "title": "Parcelle cadastrale",
            "type": "string",
            "description": "Identifiant unique de parcelle"
          },
          {
            "name": "emprise_m2",
            "title": "Emprise au sol (m²)",
            "type": "number",
            "description": "Surface calculée en CC45"
          },
          {
            "name": "nb_etages",
            "title": "Nombre d'étages",
            "type": "integer",
            "description": "BD TOPO"
          },
          {
            "name": "hauteur_m",
            "title": "Hauteur (m)",
            "type": "number",
            "description": "BD TOPO"
          },
          {
            "name": "sdp_estimee_m2",
            "title": "Surface de plancher estimée (m²)",
            "type": "number",
            "description": "Emprise × nombre de niveaux, à confirmer par relevé"
          },
          {
            "name": "usage_bdtopo",
            "title": "Usage BD TOPO",
            "type": "string",
            "description": "Usage principal selon l'IGN"
          },
          {
            "name": "nb_locaux",
            "title": "Nombre de locaux DGFiP",
            "type": "integer",
            "description": "Locaux de la commune recensés sur la parcelle"
          },
          {
            "name": "id_rnb",
            "title": "Identifiant(s) RNB",
            "type": "string",
            "description": "Référentiel national des bâtiments"
          },
          {
            "name": "cleabs",
            "title": "Identifiant BD TOPO",
            "type": "string",
            "description": "Lien vers la BD TOPO"
          },
          {
            "name": "longitude",
            "type": "number",
            "description": "WGS84, point intérieur"
          },
          {
            "name": "latitude",
            "type": "number",
            "description": "WGS84, point intérieur"
          }
        ],
        "primaryKey": "id_bien"
      }
    },
    {
